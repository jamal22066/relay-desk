# Local test directory for LDAP authentication. Not for production.
#
# CHANGE_ME_LDAP_TEST_PASSWORD is a placeholder, not a usable password.
# Substitute your own before loading, and export the same value as
# LDAP_TEST_PASSWORD for scripts/ldap_test.sh:
#
#   export LDAP_TEST_PASSWORD='choose-something'
#   sed "s/CHANGE_ME_LDAP_TEST_PASSWORD/$LDAP_TEST_PASSWORD/" ldap-dev/bootstrap.ldif > /tmp/bootstrap.ldif
#
# The base DN matches the LDAP_* examples in .env.example.

dn: cn=accounts,dc=example,dc=com
objectClass: nsContainer
objectClass: top
cn: accounts

dn: cn=users,cn=accounts,dc=example,dc=com
objectClass: nsContainer
objectClass: top
cn: users

dn: cn=groups,cn=accounts,dc=example,dc=com
objectClass: nsContainer
objectClass: top
cn: groups

dn: uid=asmith,cn=users,cn=accounts,dc=example,dc=com
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: asmith
cn: Alex Smith
sn: Smith
displayName: Alex Smith
mail: alex.smith@example.com
userPassword: CHANGE_ME_LDAP_TEST_PASSWORD

dn: uid=sjones,cn=users,cn=accounts,dc=example,dc=com
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: sjones
cn: Sam Jones
sn: Jones
displayName: Sam Jones
mail: sam.jones@example.com
userPassword: CHANGE_ME_LDAP_TEST_PASSWORD

dn: uid=external,cn=users,cn=accounts,dc=example,dc=com
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: external
cn: Ext Contractor
sn: Contractor
displayName: Ext Contractor
mail: ext@example.com
userPassword: CHANGE_ME_LDAP_TEST_PASSWORD

dn: cn=support-staff,cn=groups,cn=accounts,dc=example,dc=com
objectClass: top
objectClass: groupOfNames
cn: support-staff
member: uid=asmith,cn=users,cn=accounts,dc=example,dc=com
member: uid=sjones,cn=users,cn=accounts,dc=example,dc=com
