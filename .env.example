DATABASE_URL=postgresql+psycopg://relay:relay_dev@127.0.0.1:5432/relaydesk
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=generate-with-python3-c-import-secrets-print-secrets-token_urlsafe-48
SESSION_HOURS=12
COOKIE_SECURE=false

# LDAP / FreeIPA (leave LDAP_ENABLED=false for local-only auth)
LDAP_ENABLED=false
LDAP_SERVER=ldaps://ipa.example.com:636
LDAP_BIND_DN=uid=svc-relay,cn=users,cn=accounts,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=cn=users,cn=accounts,dc=example,dc=com
LDAP_USER_FILTER=(&(objectClass=inetOrgPerson)(mail={email}))
LDAP_GROUP_BASE=cn=groups,cn=accounts,dc=example,dc=com
LDAP_AGENT_GROUP=cn=support-staff,cn=groups,cn=accounts,dc=example,dc=com
LDAP_ATTR_NAME=displayName
LDAP_ATTR_EMAIL=mail
LDAP_TLS_VERIFY=true
