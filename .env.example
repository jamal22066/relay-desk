DATABASE_URL=postgresql+psycopg://relay:relay_dev@127.0.0.1:5432/relaydesk
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=generate-with-python3-c-import-secrets-print-secrets-token_urlsafe-48
SESSION_HOURS=12
COOKIE_SECURE=false

# LDAP / FreeIPA (leave LDAP_ENABLED=false for local-only auth)
LDAP_ENABLED=false
LDAP_SERVER=ldaps://ipa.example.com:636
LDAP_BIND_DN=uid=svc-relay,cn=users,cn=accounts,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=cn=users,cn=accounts,dc=example,dc=com
LDAP_USER_FILTER=(&(objectClass=inetOrgPerson)(mail={email}))
LDAP_GROUP_BASE=cn=groups,cn=accounts,dc=example,dc=com
LDAP_AGENT_GROUP=cn=support-staff,cn=groups,cn=accounts,dc=example,dc=com
LDAP_ATTR_NAME=displayName
LDAP_ATTR_EMAIL=mail
LDAP_TLS_VERIFY=true

# OIDC single sign-on (leave OIDC_ENABLED=false to hide the SSO button).
# Any compliant provider works — the values below are the local Keycloak in
# keycloak-dev/. See "Other identity providers" in README.md for the claim
# differences between Entra ID, Okta and Google.
OIDC_ENABLED=false
OIDC_ISSUER=http://localhost:8081/realms/relay-desk
OIDC_CLIENT_ID=relay-desk
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
OIDC_SCOPES=openid email profile
# the claim carrying group membership: 'groups' for Keycloak and Okta,
# 'roles' for Entra ID App Roles
OIDC_GROUPS_CLAIM=groups
OIDC_AGENT_GROUP=support-staff
OIDC_ADMIN_GROUP=administrators
# where the provider returns the browser after "Sign out everywhere".
# Must be registered with the provider; defaults to APP_BASE_URL.
OIDC_POST_LOGOUT_REDIRECT_URI=

# SMTP (Google Workspace: smtp.gmail.com:587 with an App Password)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Relay desk
# SAFETY: only these recipients receive mail. "*" disables the guard.
# Accepts full addresses or @domain suffixes, comma separated.
SMTP_ALLOWLIST=
APP_BASE_URL=http://127.0.0.1:5173
